{
  "env": "user",
  "projects": {
    "agent-memory": {
      "path": "C:\\path\\to\\your\\vault\\AgentMemory",
      "mode": "local"
    }
  },
  "default_project": "agent-memory",
  "semantic_embedding_provider": "openai",

[Unit]
Description=local-agent-memory Read-Only Basic Memory MCP Server (127.0.0.1:8765)
After=network.target

[Service]
Type=simple
Environment="BASIC_MEMORY_READ_ONLY=true"
Environment="HF_HUB_OFFLINE=1"
Environment="PYTHONUTF8=1"
Environment="LOGFIRE_IGNORE_NO_CONFIG=1"
Environment="NO_PROXY=127.0.0.1,localhost"
Environment="no_proxy=127.0.0.1,localhost"
ExecStart=%h/.local/bin/bm mcp --transport streamable-http --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
